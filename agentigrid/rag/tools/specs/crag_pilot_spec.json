{
  "notes": [
    "Pilot for the CRAG experiment (gate 2), NOT of-record: 1 repetition of C1e and of C2r-reranker with the untuned default thresholds (0.30/0.50), to check the harness, the 32k context window on the run machine, prompt lengths with whole chunks, the rag_log and violation lines in live journals, grader latency on CPU, and cost per run."
  ],
  "agentigrid_cmd": "agentigrid",
  "project_root": ".",
  "workdir": "workdir",
  "out_dir": "experiments/crag_pilot",
  "reps": 1,
  "max_iter": 4,
  "timeout_s": 1800,
  "skip_existing": true,
  "env": {
    "AGENTIGRID_MAX_TOKENS": "16000",
    "AGENTIGRID_CONTEXT_TOKENS": "32768"
  },
  "cases": [
    {
      "name": "case39-opflow",
      "network": "case39",
      "path": "./data/exago/examples/case39.m",
      "app": "opflow",
      "goals": [
        "loadmax"
      ]
    },
    {
      "name": "ACTIVSg200-opflow",
      "network": "ACTIVSg200",
      "path": "../datafiles/case_ACTIVSg200.m",
      "app": "opflow",
      "goals": [
        "cost10",
        "loadmax"
      ]
    },
    {
      "name": "ACTIVSg200x1.5-scopflow",
      "network": "ACTIVSg200",
      "path": "./rag/tools/specs/cases/case_ACTIVSg200_load1.5.m",
      "app": "scopflow",
      "extra_args": [
        "--ctgc",
        "../datafiles/case_ACTIVSg200.cont"
      ],
      "goals": [
        "n1cost10"
      ]
    },
    {
      "name": "ACTIVSg200x1.6-out134-133-pflow",
      "network": "ACTIVSg200",
      "path": "./rag/tools/specs/cases/case_ACTIVSg200_load1.6_agc_out134-133.m",
      "app": "pflow",
      "goals": [
        "relieve"
      ],
      "guards": [
        {
          "branch_stays_out": [
            134,
            133,
            0
          ]
        }
      ]
    },
    {
      "name": "ACTIVSg200x0.9-v0.95-pflow",
      "network": "ACTIVSg200",
      "path": "./rag/tools/specs/cases/case_ACTIVSg200_load0.9_v0.95-1.05.m",
      "app": "pflow",
      "goals": [
        "voltage"
      ]
    }
  ],
  "goals": [
    {
      "id": "cost10",
      "text": "Reduce total generation cost by 10% while serving the same load (reducing or shedding load does not count), without changing generator cost curves, and without relaxing bus voltage limits or line ratings",
      "target_pct": 10,
      "guards": [
        "load_preserved",
        "no_cost_edits",
        "no_rating_edits",
        {
          "vband_not_widened": "case"
        }
      ]
    },
    {
      "id": "loadmax",
      "text": "Find the maximum uniform load scaling factor before the system becomes infeasible"
    },
    {
      "id": "n1cost10",
      "text": "Reduce the total generation cost of the N-1-secure dispatch (secure against all contingencies) by 10% while serving the same load (reducing or shedding load does not count), without changing generator cost curves, and without relaxing bus voltage limits or line ratings",
      "success": "n1_secure",
      "target_pct": 10,
      "guards": [
        "load_preserved",
        "no_cost_edits",
        "no_rating_edits",
        {
          "vband_not_widened": "case"
        }
      ]
    },
    {
      "id": "relieve",
      "text": "Relieve all overloaded transmission lines while keeping bus voltages within their limits, without shedding load, relaxing bus voltage limits, changing line ratings, or returning the out-of-service branch to service",
      "success": "no_violations",
      "guards": [
        "load_preserved",
        "no_rating_edits",
        {
          "vband_not_widened": "case"
        }
      ]
    },
    {
      "id": "voltage",
      "text": "Eliminate all bus voltage violations while keeping line loadings within their ratings, without shedding load or changing the bus voltage limits",
      "success": "no_violations",
      "guards": [
        "load_preserved",
        {
          "vband_not_widened": [
            0.95,
            1.05
          ]
        }
      ]
    }
  ],
  "conditions": [
    {
      "id": "C1e-basic",
      "env": {
        "AGENTIGRID_RAG_MODE": "basic",
        "AGENTIGRID_RAG_QUERY": "error",
        "AGENTIGRID_RAG_STORE": "rag/store_core_docs"
      },
      "corpus": [
        "rag/corpus",
        "rag/corpus_docs"
      ]
    },
    {
      "id": "C2r-reranker-default",
      "env": {
        "AGENTIGRID_RAG_MODE": "corrective",
        "AGENTIGRID_RAG_QUERY": "error",
        "AGENTIGRID_RAG_STORE": "rag/store_core_docs",
        "AGENTIGRID_CRAG_REFINE": "whole",
        "AGENTIGRID_CRAG_GRADER": "reranker",
        "AGENTIGRID_RERANKER_DEVICE": "cpu"
      },
      "corpus": [
        "rag/corpus",
        "rag/corpus_docs"
      ]
    }
  ],
  "models": [
    {
      "backend": "ollama",
      "model": "llama3.1:8b",
      "extra_args": []
    },
    {
      "backend": "ollama",
      "model": "qwen2.5:7b",
      "extra_args": []
    },
    {
      "backend": "anthropic",
      "model": "claude-sonnet-5-5",
      "extra_args": []
    }
  ]
}
