{
  "agentigrid_cmd": "agentigrid",
  "project_root": ".",
  "workdir": "workdir",
  "out_dir": "experiments/grader_ablation_v1",
  "reps": 10,
  "max_iter": 4,
  "timeout_s": 1800,
  "skip_existing": true,
  "cases": [
    { "name": "case39", "path": "./data/case39.m", "app": "opflow" }
  ],
  "goals": [
    { "id": "cost10",  "text": "Reduce total generation cost by 10%", "target_pct": 10 },
    { "id": "loadmax", "text": "Find the maximum uniform load scaling factor before the system becomes infeasible" }
  ],
  "conditions": [
    { "id": "C0-norag",       "env": { "AGENTIGRID_RAG_MODE": "off" } },
    { "id": "C1-basic",       "env": { "AGENTIGRID_RAG_MODE": "basic" } },
    { "id": "C2-crag-cosine", "env": { "AGENTIGRID_RAG_MODE": "corrective", "AGENTIGRID_CRAG_GRADER": "cosine" } },
    { "id": "C3-crag-jev",    "env": { "AGENTIGRID_RAG_MODE": "corrective", "AGENTIGRID_CRAG_GRADER": "jev" } }
  ],
  "models": [
    { "backend": "ollama",    "model": "llama3:latest",    "extra_args": [] },
    { "backend": "ollama",    "model": "qwen2.5:7b",       "extra_args": [] },
    { "backend": "anthropic", "model": "claude-sonnet-4-6", "extra_args": [] }
  ]
}
