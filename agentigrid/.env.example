# AgentiGrid credentials — EXAMPLE / TEMPLATE
# ---------------------------------------------------------------------------
# Copy this file to `.env` in the same directory, then fill in your own values:
#     cp .env.example .env
# `.env` is gitignored and must NEVER be committed. This example file is safe
# to commit because it contains no real secrets.
#
# The application reads these from the environment. env.sh (Phase 8) loads
# `.env` automatically via `set -a; source .env; set +a`, so once you create
# it you don't touch env.sh again.
# ---------------------------------------------------------------------------

# Anthropic API key — REQUIRED only for the Anthropic backend.
# Get one at https://console.anthropic.com (Billing is separate from Claude
# Pro / the desktop app). It is per-user: use your own, don't share.
# Leave as-is / delete this line if you only use the local Ollama backend.
export ANTHROPIC_API_KEY="sk-ant-api03-REPLACE_WITH_YOUR_OWN_KEY"

# ---------------------------------------------------------------------------
# Optional — usually set by env.sh at runtime, override here only if needed.
# ---------------------------------------------------------------------------

# Ollama host (local, free backend). env.sh auto-detects the WSL->Windows NAT
# gateway IP each session; set this only to pin a specific host:port.
# export OLLAMA_HOST="http://172.x.x.x:11434"

# RAG generation-stage grounding ablation switch (0 = off, 1 = on).
# The Streamlit UI sets this itself; useful here for CLI ablation runs.
# export AGENTIGRID_RAG="1"
